# ============================================================
# 婚禮相簿系統 - 環境變數設定
# 複製此檔案為 .env.local 並填入實際值
# ============================================================

# ------------------------------------------------------------
# Admin 密碼（必填）
# ------------------------------------------------------------
ADMIN_PASSWORD=your_strong_admin_password_here

# JWT Secret（必填，請使用隨機長字串）
JWT_SECRET=your_very_long_random_jwt_secret_here_at_least_32_chars

# ------------------------------------------------------------
# Firebase（必填）
# 從 Firebase Console > Project Settings > Service Accounts 取得
# ------------------------------------------------------------

# Client SDK（前端用，可公開）
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef

# Server SDK（後端用，不可公開）
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# 將 Service Account JSON 的 private_key 值貼入（保留換行符號 \n）
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END RSA PRIVATE KEY-----\n"

# ------------------------------------------------------------
# Google Drive API（必填）
# 從 Google Cloud Console > Service Accounts 建立並下載 JSON
# ------------------------------------------------------------

# Google Drive Service Account（後端用，不可公開）
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END RSA PRIVATE KEY-----\n"

# 目標 Google Drive 資料夾 ID（必填）
GOOGLE_DRIVE_ROOT_FOLDER_ID=1vH-2oFx6IMIzY_kGEwrfcqLOiauMjpD0

# ------------------------------------------------------------
# 應用程式設定（選填）
# ------------------------------------------------------------

# 網站 URL（Vercel 部署後填入）
NEXT_PUBLIC_APP_URL=https://your-wedding-app.vercel.app

# Rate Limit 設定（每分鐘最多上傳次數，預設 10）
RATE_LIMIT_MAX=10
