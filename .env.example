# ============================================================
# 婚禮相簿系統 - 環境變數設定
# 複製此檔案為 .env.local 並填入實際值
# ============================================================

# ------------------------------------------------------------
# 管理端存取密鑰 —— 不在這個檔案裡
# ------------------------------------------------------------
# 管理端不需要輸入密碼，改以「知道網址」進入：
#   https://你的網址/api/admin/unlock?key=<密鑰>
# 開過一次後 cookie 保留 30 天，之後直接開 /admin 即可。
#
# 密鑰存在 Firestore（settings/config.adminAccessKey），不在原始碼、也不在
# 環境變數裡：這個 repo 是公開的，而改環境變數還得重新部署。設定或更換：
#   node scripts/set-admin-key.mjs        # 產生一把新的
#   node scripts/set-admin-key.mjs show   # 查看目前這把
#
# 本機 npm run dev 不需要密鑰，/admin 直接開得起來。

# ------------------------------------------------------------
# Firebase（必填）
# 從 Firebase Console > Project Settings > Service Accounts 取得
# ------------------------------------------------------------

# Client SDK（前端用，可公開）
NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef

# Server SDK（後端用，不可公開）
FIREBASE_ADMIN_PROJECT_ID=your-project-id
FIREBASE_ADMIN_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# 將 Service Account JSON 的 private_key 值貼入（保留換行符號 \n）
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END RSA PRIVATE KEY-----\n"

# ------------------------------------------------------------
# Google Drive API（必填）
# 從 Google Cloud Console > Service Accounts 建立並下載 JSON
# ------------------------------------------------------------

# Google Drive Service Account（後端用，不可公開）
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END RSA PRIVATE KEY-----\n"

# 目標 Google Drive 資料夾 ID（必填）
GOOGLE_DRIVE_ROOT_FOLDER_ID=your_shared_drive_root_folder_id

# 備份目的地資料夾 ID（scripts/backup.mjs 用）
BACKUP_FOLDER_ID=your_personal_drive_backup_folder_id

# ------------------------------------------------------------
# 應用程式設定（選填）
# ------------------------------------------------------------

# 網站 URL（Vercel 部署後填入）
NEXT_PUBLIC_APP_URL=https://your-wedding-app.vercel.app

# Rate Limit 設定（每分鐘最多上傳次數，預設 10）
RATE_LIMIT_MAX=10

# 闖關任務上傳資料夾 ID（/mission 頁面用，與相簿資料夾分開）
MISSION_DRIVE_FOLDER_ID=your_mission_folder_id
